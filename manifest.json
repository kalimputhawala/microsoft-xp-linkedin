{
    "manifest_version": 3,
    "name": "LinkedIn XP — Yahoo Messenger",
    "version": "1.0.0",
    "description": "Windows XP inspired LinkedIn with a Start menu, full-width content and classic Yahoo Messenger styling.",
    "minimum_chrome_version": "105",
    "icons": {
        "128": "icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/*",
                "https://linkedin.com/*"
            ],
            "css": ["theme.css"],
            "js": ["theme-shadow.js", "theme.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ]
}
